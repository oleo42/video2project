# Volcengine Ark (Coding Plan)
# Per user memory: ONLY use /api/coding/v1 — never /api/v3 (different billing).
VOLCENGINE_API_KEY=your-volcengine-ark-key
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
VOLCENGINE_MODEL=doubao-lite

# Project output location
# Default: ~/Documents/video2project/
# Override to keep output inside the repo (e.g. ./output) for dev
VIDEO2PROJECT_HOME=

# Logging
LOG_LEVEL=INFO

# YouTube fetch resilience (optional). All yt-dlp calls run a fallback chain:
#   anonymous → cookies (if YTDLP_COOKIES set) → PO-token script (if present)
# Per-stream proxy throttling is always handled via --http-chunk-size 1M.
#
# Path to a Netscape cookies.txt exported from a browser logged into YouTube.
# Needed when the proxy exit IP is flagged ("Sign in to confirm you're not a bot").
#YTDLP_COOKIES=
#
# Path to the bgutil PO-token server dir (contains src/generate_once.ts).
# Default: ~/bgutil-ytdlp-pot-provider/server. Rarely helps a flagged IP.
#YTDLP_POT_SCRIPT=
