{
  "manifest_version": 3,
  "name": "video2project Capture",
  "version": "0.1.0",
  "description": "Capture YouTube audio + keyframes in the browser and send them to your local video2project pipeline (transcript, OCR, notes).",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "video2project Capture"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*", "https://m.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png"
  }
}
